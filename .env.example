# Copier en .env et renseigner les clés (toutes optionnelles).
# Sans clé, seules les sources gratuites répondent et le verdict repose davantage sur le ML.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
OTX_API_KEY=
# abuse.ch (URLhaus + ThreatFox) : une seule clé Auth-Key gratuite
ABUSECH_API_KEY=
PHISHTANK_API_KEY=

# Modèle ML (voir README) — hash épinglé par défaut, ne changer que pour un modèle custom
# BT_URL_MODEL_PATH=
# BT_URL_MODEL_SHA256=
# BT_URL_ALLOW_UNVERIFIED_MODEL=false
