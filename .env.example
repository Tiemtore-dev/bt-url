# Copier en .env (jamais commité) puis renseigner.

# ── Déploiement (docker compose) ─────────────────────────────────────────────
DOMAIN=bt-url.exemple.com        # nom de domaine pointant vers le VPS ; "localhost" pour un test local

# ── Clés API (toutes optionnelles : seules les sources renseignées sont interrogées) ─────────────
VIRUSTOTAL_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
OTX_API_KEY=
ABUSECH_API_KEY=                 # URLhaus + ThreatFox (clé gratuite abuse.ch)
PHISHTANK_API_KEY=

# ── Protection des quotas (valeurs par défaut) ───────────────────────────────
# BT_URL_RATE_PER_MIN=3          # analyses / minute / IP
# BT_URL_RATE_PER_HOUR=20        # analyses / heure / IP
# BT_URL_GLOBAL_PER_MIN=4        # plafond global (quota gratuit VirusTotal)
# BT_URL_DAILY_BUDGET=300        # analyses réelles par jour (UTC)
# BT_URL_CACHE_TTL=3600          # secondes
# VT_MIN_ENGINES=3               # moteurs VirusTotal requis pour un verdict « autoritaire »

# Le modèle ML est en cours d'entraînement : désactivé, rien à configurer.
